{
  "name": "h5-devtools-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.xianguoGou/h5-devtools-mcp",
  "description": "MCP server that lets coding agents debug H5 pages inside Android WebViews and iOS WKWebViews on real devices and simulators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianguoGou/h5-devtools-mcp.git"
  },
  "homepage": "https://github.com/xianguoGou/h5-devtools-mcp#readme",
  "bugs": {
    "url": "https://github.com/xianguoGou/h5-devtools-mcp/issues"
  },
  "type": "module",
  "bin": {
    "h5-devtools-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test:e2e": "node test/e2e/run.mjs",
    "prepack": "npm run build",
    "test:e2e:ios": "node test/e2e/run-ios.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "webview",
    "android",
    "h5",
    "cdp",
    "devtools",
    "claude-code",
    "ios",
    "wkwebview",
    "safari"
  ],
  "license": "MIT",
  "author": "xianguoGou",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chrome-remote-interface": "^0.34.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "devtools-protocol": "^0.0.1710668",
    "typescript": "^7.0.2"
  }
}
